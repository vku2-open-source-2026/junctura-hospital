{
  "name": "junctura-hospital",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital application on Junctura DX-OS: shared Health UI and Junctura sign-in.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://junctura.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vku2-open-source-2026/junctura-hospital.git"
  },
  "bugs": {
    "url": "https://github.com/vku2-open-source-2026/junctura-hospital/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "npm --prefix web run dev",
    "dev:server": "node server/main.mjs --port 5192",
    "build": "npm --prefix web run build && node scripts/copy-notices.mjs",
    "web:install": "npm --prefix web ci",
    "web:test": "npm --prefix web test",
    "check": "node scripts/check.mjs",
    "check:reuse": "node scripts/check-reuse.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:referrals:live": "node scripts/check-referral-live.mjs",
    "workflow:setup": "node scripts/setup-admission-workflow.mjs",
    "demo:prepare": "node scripts/prepare-referral-demo.mjs",
    "demo:clear": "node scripts/prepare-referral-demo.mjs --clear",
    "demo:start": "node server/main.mjs --demo",
    "demo:exam:prepare": "node scripts/prepare-referral-demo.mjs --treatment",
    "demo:exam:clear": "node scripts/prepare-referral-demo.mjs --treatment --clear",
    "demo:rx:prepare": "node scripts/prepare-referral-demo.mjs --prescribing",
    "demo:rx:clear": "node scripts/prepare-referral-demo.mjs --prescribing --clear",
    "demo:pharmacy:prepare": "node scripts/prepare-referral-demo.mjs --pharmacy",
    "demo:pharmacy:clear": "node scripts/prepare-referral-demo.mjs --pharmacy --clear",
    "demo:provider:up": "node scripts/provider-demo.mjs",
    "demo:provider:down": "node scripts/provider-demo.mjs --down",
    "test:prescriptions:live": "node scripts/check-prescriptions-live.mjs",
    "test:emergency:live": "node scripts/check-emergency-live.mjs"
  },
  "dependencies": {
    "@junctura/health-contracts": "^1.1.0",
    "@junctura/server-client": "^0.1.0"
  }
}
