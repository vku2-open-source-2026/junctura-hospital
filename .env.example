# Local/demo settings. Health demo:setup supplies the private application env.
JUNCTURA_HEALTH_DIR=../junctura-health
# JUNCTURA_HOSPITAL_ENV=../junctura-health/.junctura/demo/junctura-hospital.env
HOST=127.0.0.1
# PORT=5182
# JUNCTURA_ISSUER=http://127.0.0.1:8080/identity/realms/junctura
# JUNCTURA_WEB_CLIENT_ID=health-hospital-web
# HOSPITAL_STATIC_DIR=web/dist
# .env is not loaded implicitly: use environment variables or node --env-file=.env server/main.mjs.

# Optional: exact registered Clinic application UUID; defaults to the Health demo Clinic env.
# JUNCTURA_REFERRAL_PROVIDER_APP_ID=
# Core backend credentials are read privately from the Hospital Health env.
